","url":"/guides#use-extensions","content":"Review and change an extension's permissions and site access without changing another Crest Space."},"846":{"id":"/guides-40","page_id":"/guides","tags":[],"type":"text","url":"/guides#use-extensions","content":"Pin extension actions and use popups, side panels, and settings pages in the right Space on Mac."},"847":{"id":"/guides-41","page_id":"/guides","tags":[],"type":"text","url":"/guides#use-extensions","content":"Assign and change keyboard shortcuts for extension commands in a Crest Space."},"848":{"id":"/guides-42","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":"See whether an extension is on, and find its errors and permissions in Chromium's extension manager."},"849":{"id":"/guides-43","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":"How extensions in Crest for Mac connect to their companion Mac apps, and what those apps check."},"850":{"id":"/guides-44","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":"Which extensions Crest runs, where, and which Chrome extension features Crest connects to its own interface."},"851":{"id":"/guides-45","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":"Where extensions run in Crest, and the limits that apply to them."},"852":{"id":"/guides-46","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":"Steps to try when a Chrome extension installs in Crest but a feature does not work."},"853":{"id":"/guides-47","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":"Install the 1Password Chrome extension in Crest for Mac and authorize Crest in the 1Password app."},"854":{"id":"/guides-48","page_id":"/guides","tags":[],"type":"text","url":"/guides#compatibility--troubleshooting","content":